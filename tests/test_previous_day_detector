from datetime import datetime

from auctionlab.observation.previous_day import previous_day
from auctionlab.observation.trading_day import TradingDay
from auctionlab.reality.bar_series import BarSeries
from auctionlab.reality.candle import Candle


def make_day(date: str) -> TradingDay:
    return TradingDay(
        date=date,
        bars=BarSeries(
            [
                Candle(
                    timestamp=datetime.now(),
                    open=1,
                    high=2,
                    low=0,
                    close=1,
                )
            ]
        ),
    )


def test_previous_day():
    days = [
        make_day("2026-01-05"),
        make_day("2026-01-06"),
        make_day("2026-01-07"),
    ]

    assert previous_day(days, 2).date == "2026-01-06"